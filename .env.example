# Copie este arquivo para ".env" e preencha com suas credenciais reais
# NUNCA suba o arquivo .env (só o .env.example) para o GitHub!

# --- Spotify Developer Dashboard ---
SPOTIFY_CLIENT_ID=coloque_seu_client_id_aqui
SPOTIFY_CLIENT_SECRET=coloque_seu_client_secret_aqui
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- AWS (usuário IAM veridis-app) ---
AWS_ACCESS_KEY_ID=coloque_sua_access_key_aqui
AWS_SECRET_ACCESS_KEY=coloque_sua_secret_key_aqui
AWS_BUCKET_NAME=veridis-jgois
AWS_REGION=sa-east-1

# --- Banco de dados (AWS RDS - PostgreSQL) ---
DB_HOST=coloque_o_endpoint_da_instancia_aqui
DB_PORT=5432
DB_NAME=veridis
DB_USER=coloque_seu_usuario_aqui
DB_PASSWORD=coloque_sua_senha_aqui
